@rendermode InteractiveWebAssembly

<PageTitle>StressTestGraph</PageTitle>

<h1>StressTestGraph</h1>

<Row>
    @if (_data != null)
    {
        <Check TValue="bool"
               Inline
               Style="display:inline-block; margin-right:5px;"
               Value="series1Hidden"
               ValueChanged="StatusHasChanged1" />
        <Check TValue="bool"
               Inline
               Style="display:inline-block; margin-right:5px;"
               Value="series2Hidden"
               ValueChanged="SatusHasChanged2" />
    }
</Row>
<Row>
    <Column ColumnSize="ColumnSize.Is6">
        <SvgChart TItem="(DateTime time, double value, double value2, double avg, double avg2)" Items="_data">
            <SvgChartTimeAxis Id="time" TimeValue="@(item => item.time)" Scale="SvgChartTimeScale.Continuous" Unit="SvgChartTimeUnit.Hour" />
            <SvgScatterSeries Hidden="series1Hidden" CategoryAxisId="time" Name="dots1" Value="@(item => item.value)" MarkerRadius="0.8" Color="Color.Primary" />
            <SvgScatterSeries Hidden="series2Hidden" CategoryAxisId="time" Name="dots2" Value="@(item => item.value2)" MarkerRadius="0.8" Color="Color.Danger" />
            <SvgLineSeries Hidden="series1Hidden" MarkerRadius="0" StrokeWidth="2" CategoryAxisId="time" Name="line1" Value="@(item => item.avg)" Color="Color.Primary" />
            <SvgLineSeries Hidden="series2Hidden" MarkerRadius="0" StrokeWidth="2" CategoryAxisId="time" Name="line2" Value="@(item => item.avg2)" Color="Color.Danger" />
        </SvgChart>
    </Column>
</Row>

@code {

}
