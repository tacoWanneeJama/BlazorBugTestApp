<h3>CheckTest</h3>

<Div>
    <Check TValue="bool" Value="@AreAllSelected" Indeterminate="@AreSomeSelected" ValueChanged="@OnSelecetAllChanged">
        Select all
    </Check>
    <Div Display="Display.Flex" Flex="Flex.Column" Gap="Gap.Is2" Margin="Margin.Is3.FromTop">
    @foreach (var item in Items)
    {
        <Check TValue="bool" Value="@selectedItems.Contains(item)" ValueChanged="@((bool val) => OnItemCheckedChanged(item, val))">
            @item
        </Check>
    }
    </Div>
</Div>
